+def _atomic_save(obj: dict, path: str):
+    """Write JSON atomically (temp file + rename) so a killed job never leaves a corrupt file."""
+    tmp = f"{path}.tmp"
+    with open(tmp, "w") as f:
+        json.dump(obj, f)
+    os.replace(tmp, path)
+
+
+def _worker_loop(task_queue, result_queue, device_index: int):
+    """Runs in a spawned subprocess with its own CUDA context.
+
+    Pulls measurement tasks, times the reference program, and reports
+    `(stats, healthy)`. `healthy` is False once a sticky CUDA error (e.g. a
+    device-side assert) has poisoned the context; the worker then exits so the
+    parent can respawn a clean one. This isolates the rest of the run from a
+    single bad problem instead of letting it return None for everything after.
+    """
+    import torch
+    from kernelbench.timing import measure_ref_program_time
+
+    device = torch.device(f"cuda:{device_index}")
+    while True:
+        task = task_queue.get()
+        if task is None:  # shutdown sentinel
+            break
+        try:
+            stats = measure_ref_program_time(device=device, verbose=False, **task)
+        except Exception as e:  # defensive: measure_ref_program_time already swallows most
+            print(f"[Eval] Worker error measuring {task.get('ref_arch_name')}: {e}")
+            stats = None
+
+        # Health probe: detect a poisoned CUDA context (sticky device-side assert).
+        healthy = True
+        try:
+            torch.cuda.synchronize(device=device)
+            probe = torch.ones(1, device=device) + 1
+            torch.cuda.synchronize(device=device)
+            del probe
+        except Exception:
+            healthy = False
+
+        result_queue.put((stats, healthy))
+        if not healthy:
+            break
+
+
+class IsolatedRunner:
+    """Measures each problem in a restartable worker subprocess.
+
+    The worker persists across problems (so the common path stays fast and pays
+    CUDA init only once), and is killed + respawned only when it poisons its
+    context, hangs past `timeout`, or dies unexpectedly.
+    """
+
+    def __init__(self, device_index: int = 0, timeout: float = 600.0):
+        self.ctx = mp.get_context("spawn")
+        self.device_index = device_index
+        self.timeout = timeout
+        self.proc = None
+        self.task_queue = None
+        self.result_queue = None
+
+    def _ensure_worker(self):
+        if self.proc is not None and self.proc.is_alive():
+            return
+        self._kill()
+        self.task_queue = self.ctx.Queue()
+        self.result_queue = self.ctx.Queue()
+        self.proc = self.ctx.Process(
+            target=_worker_loop,
+            args=(self.task_queue, self.result_queue, self.device_index),
+            daemon=True,
+        )
+        self.proc.start()
+
+    def measure(self, task: dict):
+        self._ensure_worker()
+        self.task_queue.put(task)
+        try:
+            stats, healthy = self.result_queue.get(timeout=self.timeout)
+        except Exception:
+            # Timed out or worker died without responding: drop it, respawn next call.
+            self._kill()
+            return None
+        if not healthy:
+            # Context poisoned; worker is exiting. Drop it so a fresh one spawns next call.
+            self._kill()
+        return stats
+
+    def _kill(self):
+        if self.proc is not None:
+            try:
+                if self.proc.is_alive():
+                    self.proc.terminate()
+                    self.proc.join(timeout=10)
+                if self.proc.is_alive():
+                    self.proc.kill()
+                    self.proc.join(timeout=10)
+            except Exception:
+                pass
+        self.proc = None
+        self.task_queue = None
+        self.result_queue = None
+
+    def close(self):
+        if self.proc is not None and self.proc.is_alive() and self.task_queue is not None:
+            try:
+                self.task_queue.put(None)
+                self.proc.join(timeout=10)
+            except Exception:
+                pass
+        self._kill()
+
+
